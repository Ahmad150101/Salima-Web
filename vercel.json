{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/assets/catalog/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }, { "key": "Content-Disposition", "value": "attachment" }] }
  ]
}
